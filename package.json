{
  "name": "worlds",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @worlds/slack dev",
    "dev:site": "wrangler d1 migrations apply worlds-db --local -c site/wrangler.jsonc && wrangler dev -c site/wrangler.jsonc -c apps/api/wrangler.jsonc --port 8790 --infer-origin-from-routes=false --persist-to site/.wrangler/state",
    "deploy:site": "wrangler deploy -c site/wrangler.jsonc",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p site",
    "smoke": "pnpm --filter @worlds/slack smoke",
    "db:generate": "pnpm --filter @worlds/db generate"
  },
  "dependencies": {
    "@worlds/db": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.168.0"
  }
}
