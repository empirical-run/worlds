{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "worlds-site",
  "account_id": "6f3f2ef0dbeefd01119c8818ed8e3dfe",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "routes": [{ "pattern": "makeworlds.dev", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*", "!/styles.css", "!/favicon.svg", "!/account.js"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worlds-db",
      "database_id": "829a6cb6-49e1-470c-a7f5-f151014f9ad6",
      "migrations_dir": "drizzle"
    }
  ],
  "secrets": {
    "required": [
      "WORLDS_GOOGLE_CLIENT_ID",
      "WORLDS_GOOGLE_CLIENT_SECRET",
      "WORLDS_GITHUB_CLIENT_ID",
      "WORLDS_GITHUB_CLIENT_SECRET"
    ]
  },
  "observability": { "enabled": true }
}
