{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worlds",
  "account_id": "6f3f2ef0dbeefd01119c8818ed8e3dfe",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "fs": "./src/stubs/fs.ts",
    "node:fs": "./src/stubs/fs.ts",
    "url": "./src/stubs/url.ts",
    "node:url": "./src/stubs/url.ts"
  },
  "workers_dev": true,
  "routes": [{ "pattern": "slack.makeworlds.dev", "custom_domain": true }],
  "assets": { "directory": "./ui/dist", "binding": "ASSETS", "run_worker_first": true },
  "build": { "command": "pnpm build", "watch_dir": "ui/src" },
  "durable_objects": { "bindings": [{ "name": "WORLD", "class_name": "World" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }],
  "observability": { "enabled": true },
  "vars": {
    "SLACK_EVENTS_URL": "https://api-preview.empirical.run/api/slack/events",
    "SLACK_REDIRECT_URIS": "",
    "WORLDS_SLACK_URL": "https://slack.makeworlds.dev"
  }
}
