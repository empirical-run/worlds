{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["@cloudflare/workers-types", "vite/client"],
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": [
    "app",
    "worker",
    "react-router.config.ts",
    "vite.config.ts",
    ".react-router/types/**/*"
  ]
}
