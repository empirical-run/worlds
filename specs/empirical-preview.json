{
  "name": "Empirical preview (api-preview)",
  "slack": {
    "team": { "id": "T0EMPREVIEW1", "name": "Empirical preview", "domain": "empirical-preview" },
    "users": [
      {
        "id": "U0ALICE00001",
        "name": "alice",
        "real_name": "Alice Tester",
        "email": "alice@empirical-preview.test"
      },
      {
        "id": "U0BOB0000001",
        "name": "bob",
        "real_name": "Bob Tester",
        "email": "bob@empirical-preview.test"
      }
    ],
    "channels": [
      {
        "id": "C0GENERAL001",
        "name": "general",
        "topic": "General discussion",
        "members": ["alice", "bob"]
      },
      {
        "id": "C0ALERTS0001",
        "name": "test-alerts",
        "topic": "Test run notifications",
        "members": ["alice"]
      }
    ],
    "apps": [
      {
        "manifest": {
          "display_information": { "name": "Empirical" },
          "features": { "bot_user": { "display_name": "empirical", "always_online": true } },
          "oauth_config": {
            "redirect_urls": [
              "https://*-dashboard-v2.empirical-run.workers.dev/api/slack/oauth/callback",
              "https://*-dashboard-v2.empirical-run.workers.dev/api/admin/integrations/slack/callback",
              "https://*.vercel.app/api/slack/oauth/callback",
              "https://*.vercel.app/api/admin/integrations/slack/callback",
              "http://localhost:3000/api/slack/oauth/callback",
              "http://localhost:3000/api/admin/integrations/slack/callback"
            ],
            "scopes": {
              "bot": [
                "app_mentions:read",
                "assistant:write",
                "channels:history",
                "chat:write",
                "chat:write.customize",
                "files:read",
                "files:write",
                "groups:history",
                "im:history",
                "im:write",
                "links:read",
                "links:write",
                "reactions:read",
                "reactions:write",
                "team:read",
                "users:read",
                "users:read.email"
              ]
            }
          },
          "settings": {
            "event_subscriptions": {
              "request_url": "https://api-preview.empirical.run/api/slack/events",
              "bot_events": [
                "app_mention",
                "message.channels",
                "message.groups",
                "message.im",
                "reaction_added",
                "link_shared",
                "entity_details_requested"
              ]
            }
          }
        },
        "credentials": {
          "client_id": "${WORLDS_SLACK_CLIENT_ID}",
          "client_secret": "${WORLDS_SLACK_CLIENT_SECRET}",
          "signing_secret": "${WORLDS_SLACK_SIGNING_SECRET}"
        }
      }
    ]
  }
}
